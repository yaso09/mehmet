{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}
