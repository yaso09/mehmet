{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "skip": true,
  "enable": true,
  "toolTimeout": 120000,
  "autoMerge": false,
  "share": "disabled",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "rm -rf /*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "*": "allow"
    },
    "external_directory": {
      "*": "deny"
    }
  }
}
